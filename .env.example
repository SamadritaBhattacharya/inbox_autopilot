# Copy to `.env` (gitignored) and fill in.
# Everything here is SERVER-SIDE ONLY. Never ship any of it to frontend/ or bridge-extension/.

# ── LLM providers (the fallback chain, in order) ────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Model slugs are CONFIGURATION, never hardcoded in code — free-tier rosters rotate, and
# these values WILL go stale. When a call fails with "model does not exist", list what your
# key can actually reach and update these three lines:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" \
#     | python -c "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data']]"
#
# classifier = small/fast (intake, routing, batched triage) · executor = large (judgment)
# validator  = small (binary checks)
LLM_MODEL_CLASSIFIER=openai/gpt-oss-20b
LLM_MODEL_EXECUTOR=openai/gpt-oss-120b
LLM_MODEL_VALIDATOR=openai/gpt-oss-20b

# ── Agent loop ──────────────────────────────────────────────────────────────
MAX_STEPS=40
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=45
LLM_MAX_OUTPUT_TOKENS=2000
CONTEXT_CONFIDENCE_THRESHOLD=0.85

# ── Email surface ───────────────────────────────────────────────────────────
# fake | playwright | extension
EMAIL_SURFACE=fake
CDP_HEADLESS=false
STEALTH=true
START_URL=https://mail.google.com
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata

# ── Security ────────────────────────────────────────────────────────────────
# Addresses and phones are ALWAYS tokenized and cannot be disabled.
# This widens coverage to best-effort personal names.
PII_TOKENIZE_NAMES=true
APPROVAL_TIMEOUT_SECONDS=600

# ── Persistence ─────────────────────────────────────────────────────────────
CHECKPOINT_DSN=sqlite:///runs/checkpoints.db
RUNS_DIR=runs

# ── Frontend ────────────────────────────────────────────────────────────────
# The ONLY variable the cockpit needs. A second one is a review-blocking finding.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/run
